<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>DisplayScale</title>
  <options customize="always" require-scripts="false" />
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true" />
  <choices-outline>
    <line choice="displayScaleApp" />
    <line choice="displayScalePane" />
  </choices-outline>
  <choice id="displayScaleApp" title="DisplayScale app (required)" description="Install the standalone DisplayScale app in Applications." start_selected="true" start_enabled="false">
    <pkg-ref id="com.bonfales.displayscale.app" />
  </choice>
  <choice id="displayScalePane" title="System Settings preference pane" description="Add DisplayScale controls to System Settings." start_selected="true" start_enabled="true">
    <pkg-ref id="com.bonfales.displayscale.prefpane" />
  </choice>
  <pkg-ref id="com.bonfales.displayscale.app" version="@VERSION@">DisplayScale-app.pkg</pkg-ref>
  <pkg-ref id="com.bonfales.displayscale.prefpane" version="@VERSION@">DisplayScale-prefpane.pkg</pkg-ref>
</installer-gui-script>
